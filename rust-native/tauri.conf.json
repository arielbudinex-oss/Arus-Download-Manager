{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arus",
  "version": "1.1.1",
  "identifier": "app.arus.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Arus",
    "copyright": "Copyright © 2026 Arus",
    "category": "Utility",
    "shortDescription": "A fast, light download manager built with Rust.",
    "longDescription": "Arus is a fast, lightweight download manager for Windows. It handles HTTP, HLS, and DASH downloads, queues, scheduled transfers, and lets you browse and download your Downloads folder from a phone or laptop on the same network.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../public/": "public/",
      "../assets/": "assets/",
      "../extension/": "extension/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": ["English", "Indonesian"],
        "displayLanguageSelector": false
      }
    }
  }
}
